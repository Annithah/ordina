# Development backend. Release builds take the HTTPS production URL from eas.json instead,
# and app.config.js refuses to build the store version without one.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Google Play scope (Tasks + ORDINA AI only). Set by the EAS "preview" and "production" profiles.
# EXPO_PUBLIC_STORE_BUILD=1
# Create these OAuth client IDs in the same Google Cloud project and use the matching backend IDs.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Public URL of your privacy policy (required by Google Play; shown in Profile).
EXPO_PUBLIC_PRIVACY_POLICY_URL=
# ORDINA AI (direct mode): the phone calls Gemini with this key, copied into SQLite on first start.
# Use a separate key from a Google project without billing; it can be read from the APK.
# Cloud builds take it from the EAS "preview" environment variables. Never commit the real key.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash
# direct (default) = phone -> Gemini; server = phone -> ORDINA backend -> Gemini (public release)
# EXPO_PUBLIC_AI_MODE=direct
