{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_STORE_BUILD": "1",
        "EXPO_PUBLIC_LOCAL_MODE": "1",
        "EXPO_PUBLIC_API_URL": "http://10.110.14.12:4000"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_STORE_BUILD": "1",
        "EXPO_PUBLIC_API_URL": "https://TODO-set-render-url"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
