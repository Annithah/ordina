{
  "expo": {
    "name": "ORDINA AI",
    "slug": "ordina",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/ordina-icon.png",
    "scheme": "ordina",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ordina-icon.png",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.ordina.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "image": "./assets/images/ordina-logo-transparent.png",
        "resizeMode": "contain",
        "backgroundColor": "#F8FAFC",
        "dark": {
          "image": "./assets/images/ordina-logo-transparent-dark.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      }
    },
    "android": {
      "package": "com.ordina.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/images/ordina-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "splash": {
        "image": "./assets/images/ordina-logo-transparent.png",
        "resizeMode": "contain",
        "backgroundColor": "#F8FAFC",
        "dark": {
          "image": "./assets/images/ordina-logo-transparent-dark.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ordina-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/ordina-logo-transparent.png",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/images/ordina-logo-transparent-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#5C4DF2"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ORDINA matches a name you mention, such as Call John. Your full address book is not uploaded."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ORDINA uses location only for arrival reminders you choose to create."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ORDINA reads the photo or video you choose so it can turn it into tasks.",
          "cameraPermission": "ORDINA uses the camera so you can capture a list, note or short video and turn it into tasks.",
          "microphonePermission": "ORDINA records audio with videos you capture so it can understand what you say."
        }
      ],
      "expo-apple-authentication",
      "expo-image",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "ORDINA uses the microphone so you can speak tasks instead of typing them.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "splash": {
      "image": "./assets/images/ordina-logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e2f3397-4f0e-4035-9dd7-292c1ad1c2fb"
      }
    },
    "owner": "anitha_dev"
  }
}
