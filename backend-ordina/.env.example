# ORDINA backend settings. Copy to .env (never commit .env). Production values go in Render.

# PostgreSQL (Neon). The server uses the POOLED string (host contains "-pooler");
# migrations use the DIRECT string. Neon console → project → Connect (pooling on / off).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Optional: a throwaway database for `npm test` (e.g. a Neon branch named "tests").
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=4000
# Required in production: 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# ORDINA AI (Gemini). Without it, AI planning answers "not available".
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest"

# Password-reset emails. Resend works over HTTPS (Render's free plan blocks SMTP ports).
# Without an email service: in development the code is printed in the server console;
# in production "forgot password" answers RESET_UNAVAILABLE. The code is never sent to the app.
RESEND_API_KEY=""
MAIL_FROM="ORDINA <onboarding@resend.dev>"
# SMTP is still supported where its ports are open:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Production only (Render sets PORT itself):
# NODE_ENV="production"
# CORS_ORIGINS=""   # comma-separated browser origins; leave empty for the Android app
