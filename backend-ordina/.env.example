DATABASE_URL="file:./data/ordina.sqlite"
PORT=4000
JWT_SECRET="replace-with-a-long-random-secret"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest"

# Google OAuth clients used by the app. Enable Google Calendar API in the same Cloud project.
GOOGLE_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""

# iOS bundle id or Apple Services ID (required for Sign in with Apple)
APPLE_CLIENT_ID=""
APPLE_BUNDLE_ID="com.ordina.app"

# Optional. If unset, forgot-password returns the 6-digit code in the API response for in-app reset.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_SECURE="false"
