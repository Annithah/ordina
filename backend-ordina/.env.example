DATABASE_URL="file:./data/ordina.sqlite"
PORT=4000
# Required in production: 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Production only (Railway sets PORT itself):
# NODE_ENV="production"
# DATABASE_URL="file:/data/ordina.sqlite"   # SQLite on the Railway volume mounted at /data
# CORS_ORIGINS=""                            # comma-separated browser origins; leave empty for the Android app
# TRUST_PROXY="1"                            # automatic when NODE_ENV=production
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest"

# Google OAuth clients used by the app. Enable Google Calendar API in the same Cloud project.
GOOGLE_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""

# iOS bundle id or Apple Services ID (required for Sign in with Apple)
APPLE_CLIENT_ID=""
APPLE_BUNDLE_ID="com.ordina.app"

# Optional. Without SMTP, forgot-password returns the 6-digit code in the API response in development only;
# in production it answers "not available" (returning the code would let anyone reset any account).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_SECURE="false"
